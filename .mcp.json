{
  "mcpServers": {
    "context7": {
      "command": "pwsh",
      "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "npx -y @upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "graphify": {
      "command": "graphify-mcp",
      "args": ["graphify-out/graph.json"]
    },
    "playwright": {
      "command": "pwsh",
      "args": ["-NoProfile", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-Command", "npx -y @playwright/mcp@latest"]
    }
  }
}
