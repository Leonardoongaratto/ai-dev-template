{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand ",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier --check:*)",
      "Bash(graphify update:*)",
      "Bash(graphify query:*)",
      "Bash(graphify path:*)",
      "Bash(graphify explain:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "PowerShell(npm run lint:*)",
      "PowerShell(npm run test:*)",
      "PowerShell(npm run build:*)",
      "PowerShell(npm test:*)",
      "PowerShell(npx vitest:*)",
      "PowerShell(npx tsc --noEmit:*)",
      "PowerShell(npx eslint:*)",
      "PowerShell(npx prettier --check:*)",
      "PowerShell(graphify update:*)",
      "PowerShell(graphify query:*)",
      "PowerShell(graphify path:*)",
      "PowerShell(graphify explain:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)"
    ]
  }
}
